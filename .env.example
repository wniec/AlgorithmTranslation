# Weights & Biases configuration.
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# `.env` is git-ignored; never commit real credentials.
# These are loaded automatically by algorithm_translation/tracking.py (python-dotenv) when you
# pass --wandb to uv run train / uv run train-td3

# Your W&B API key (https://wandb.ai/authorize). Example placeholder:
WANDB_API_KEY=ABCDEFGHIJKLMNOP

# Project the runs are logged under.
WANDB_PROJECT=algorithm-translation

# Your W&B username or team. Leave blank to use your default entity.
WANDB_ENTITY=XYZ

# Logging mode: "online" (default), "offline" (sync later), or "disabled".
WANDB_MODE=online
